STUDIO_DATABASE=local
SITE_ORIGIN=http://127.0.0.1:4319
# Allow first account setup only on HTTP loopback during local development.
LOCAL_AUTH_SETUP=true
# On HTTPS hosting, set ADMIN_SETUP_TOKEN as a secret before first account setup.
# ADMIN_SETUP_TOKEN=<random secret, at least 32 characters>

# For a separate Supabase database, see .env.supabase.example and ../ENVIRONMENT_SETUP.md

# Google OAuth Web application (optional). Keep the secret on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4320/api/auth/google/callback
